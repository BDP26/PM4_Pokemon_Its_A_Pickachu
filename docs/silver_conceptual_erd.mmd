%% Silver Conceptual ERD
%% Legend:
%% [persisted] maps to a current parquet artifact
%% [derived] conceptual entity assembled from one or more persisted artifacts
%% [sharded] conceptual entity backed by a sharded parquet family
%% [Gold-boundary] omitted from Silver by design
erDiagram
    GAMES {
        string game_version PK
        string version_group
        int generation
        string region
    }

    BOSSES {
        string boss_key PK
        string boss_name
        string boss_role
        int boss_order
        string starter_condition
    }

    PROGRESSION_STEPS {
        string progression_step_key PK
        float progression_depth
        int available_species_count
        int max_species_count
    }

    LOCATIONS {
        string location_key PK
        string location_name
        string mapping_status
    }

    ENCOUNTER_AVAILABILITY {
        string encounter_key PK
        string species_key
        int level_min
        int level_max
        float capture_rate
    }

    SPECIES {
        string species_key PK
        string display_name
        string type_1
        string type_2
    }

    MOVES {
        string move_name PK
        string type
        string damage_class
        float effective_power
    }

    LEARNABLE_MOVE_AVAILABILITY {
        string game_version CK
        string species_key CK
        string move_name CK
        int learned_level
        string learn_method
    }

    BOSS_ROSTER_MOVE_ROWS {
        string boss_roster_row_key PK
        int slot
        int move_slot
        string species_key
        string move_name
    }

    TEAMS {
        string team_key PK
        string team_role
        string origin
        int avg_level
        float progression_depth
    }

    TEAM_MEMBERS {
        string team_member_key PK
        int slot
        string species_key
        int level
        bool is_starter
    }

    COMBAT_POOL_ENTRIES {
        string pool_entry_key PK
        string species_key
        int level
    }

    MOVESET_CONTEXTS {
        string moveset_context_id PK
        string move_policy
        float candidate_move_count
    }

    MEMBER_MOVE_OPTIONS {
        string team_member_key CK
        string move_name CK
        int option_rank
        float option_score
    }

    MEMBER_MOVESET_COMBOS {
        string moveset_combo_id PK
        int combo_rank
        float combo_score
        int move_count
    }

    SAMPLING_PLANS {
        string team_key PK
        string sampling_seed
        int max_moves_per_member
        int estimated_combo_space
    }

    BOSS_MOVE_PROFILES {
        string team_member_key PK
        string team_key
        string species_key
        int level
    }

    GAMES ||--o{ BOSSES : "contains"
    GAMES ||--o{ PROGRESSION_STEPS : "contains"
    GAMES ||--o{ LOCATIONS : "contains"
    GAMES ||--o{ LEARNABLE_MOVE_AVAILABILITY : "contains"
    GAMES ||--o{ TEAMS : "contains"
    GAMES ||--o{ COMBAT_POOL_ENTRIES : "contains"

    BOSSES ||--|| PROGRESSION_STEPS : "progression profile"
    BOSSES ||--o{ ENCOUNTER_AVAILABILITY : "available before boss"
    BOSSES ||--o{ TEAMS : "boss teams"
    BOSSES ||--o{ BOSS_ROSTER_MOVE_ROWS : "reference roster rows"

    LOCATIONS ||--o{ ENCOUNTER_AVAILABILITY : "hosts"
    SPECIES ||--o{ ENCOUNTER_AVAILABILITY : "can be encountered"
    SPECIES ||--o{ LEARNABLE_MOVE_AVAILABILITY : "learns"
    SPECIES ||--o{ TEAM_MEMBERS : "instanced as"
    SPECIES ||--o{ COMBAT_POOL_ENTRIES : "eligible in pool"
    SPECIES ||--o{ BOSS_ROSTER_MOVE_ROWS : "used by boss roster"
    SPECIES ||--o{ BOSS_MOVE_PROFILES : "profiled as"

    MOVES ||--o{ LEARNABLE_MOVE_AVAILABILITY : "learnable move"
    MOVES ||--o{ BOSS_ROSTER_MOVE_ROWS : "roster move"
    MOVES ||--o{ MEMBER_MOVE_OPTIONS : "candidate move"

    TEAMS ||--|{ TEAM_MEMBERS : "has members"
    TEAMS ||--o| SAMPLING_PLANS : "player teams only"
    TEAMS ||--o{ MEMBER_MOVESET_COMBOS : "via team members"
    TEAMS ||--o{ BOSS_MOVE_PROFILES : "boss subset only"

    TEAM_MEMBERS ||--o{ MEMBER_MOVE_OPTIONS : "legal move choices"
    TEAM_MEMBERS ||--o{ MEMBER_MOVESET_COMBOS : "bounded combos"
    TEAM_MEMBERS ||--o| BOSS_MOVE_PROFILES : "boss subset only"

    COMBAT_POOL_ENTRIES ||--o{ MOVESET_CONTEXTS : "context basis"
    MOVESET_CONTEXTS ||--o{ MEMBER_MOVE_OPTIONS : "reused context"

