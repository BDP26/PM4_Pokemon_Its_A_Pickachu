    %% MEMBER_MOVE_OPTIONS -> simulation/member_move_options_<game>.parquet
    %% MEMBER_MOVESET_COMBOS -> simulation/member_moveset_combos_<game>.parquet
    %% SAMPLING_PLANS -> simulation/simulation_sampling_plan_<game>.parquet
