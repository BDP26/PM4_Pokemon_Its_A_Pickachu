%% Silver Physical ERD
%% Legend:
%% [persisted] parquet artifact on disk
%% [partitioned] parquet dataset directory with hive-style partitions
%% [sharded] repeated file family in simulation/*
%% [CK] composite key
%% [iFK] inferred foreign key validated by join
%% Gold-boundary outputs are intentionally omitted
erDiagram
    GAMES_PARQUET {
        string game_version PK
        string version_group
        int generation
        bool is_supported
        string region "partition"
    }

    BOSSES_PARQUET {
        string boss_id PK
        string boss_name_canonical
        string boss_name_kaggle
        string boss_name_aliases_list
        int boss_order
        int boss_index
        int gym_index
        string starter_condition
        string game_version "partition"
        string boss_role "partition"
    }

    BOSS_TEAM_MEMBERS_PARQUET {
        string boss_id CK
        string boss_name
        string starter_condition
        float gym_index
        int slot CK
        string pokemon_species
        int level
        string move_name
        int move_slot CK
        string source
        string game_version "partition"
        string boss_role "partition"
    }

    LOCATIONS_PARQUET {
        string location_id CK
        string walkthrough_location_name
        string normalized_location_name
        string pokeapi_area_slug_list
        string game_version "partition"
        string mapping_status "partition"
    }

    ENCOUNTERS_PARQUET {
        string boss_id CK
        string location CK
        string pokemon CK
        int level_min CK
        int level_max CK
        int encounter_chance_min CK
        int encounter_chance_max CK
        float capture_rate
        string methods_list
        string game "partition"
    }

    PROGRESSION_DEPTH_PARQUET {
        string boss_id CK
        string boss_name
        int boss_index
        int max_boss_index
        int available_species_count
        int max_species_count
        float progression_depth
        string starter_condition
        string game_version CK "partition"
    }

    POKEMON_REFERENCE_PARQUET {
        string pokemon_species PK
        string name
        string url
    }

    POKEMON_DATA_PARQUET {
        string pokemon_species PK
        string name
        int pokeapi_id
        string type_1
        string type_2
        int base_hp
        int base_attack
        int base_defense
        int base_special_attack
        int base_special_defense
        int base_speed
    }

    MOVE_REFERENCE_PARQUET {
        string move_name PK
        float power
        float raw_power
        string damage_class
        string type
        float accuracy
        int pp
        float effective_power
        string power_handling
        bool is_status_move
        bool is_damage_move
        bool is_null_power
    }

    LEARNABLE_MOVES_PARQUET {
        string move_name CK
        int learned_level
        string learn_method
        string game_version CK "partition"
        string pokemon_species CK "partition"
    }

    %% [sharded] files: simulation/source_teams_{black-white,black,blue,diamond,gold,pearl,red,ruby,sapphire,silver,white,x,y}.parquet
    SOURCE_TEAMS_SHARDED {
        string source_team_id PK
        string game_version
        string team_role
        string origin
        string boss_id
        string boss_name
        float gym_index
        string starter_condition
        string starter_base
        string starter_evolved_species
        string progression_source_team_id
        string progression_pool_id
        int avg_level
        int member_count
        bool is_player_candidate
        int boss_index
        int max_boss_index
        int available_species_count
        int max_species_count
        float progression_depth
        float boss_ace_level
        float boss_avg_level
        float level_cap_offset
    }

    %% [sharded] files: simulation/source_team_members_{black-white,black,blue,diamond,gold,pearl,red,ruby,sapphire,silver,white,x,y}.parquet
    SOURCE_TEAM_MEMBERS_SHARDED {
        string team_member_id PK
        string source_team_id CK
        string game_version
        string team_role
        string origin
        string boss_id
        string boss_name
        float gym_index
        string starter_condition
        int slot CK
        string pokemon_species
        int level
        string fixed_moves_list
        string progression_pool_id
        bool is_starter
    }

    %% [sharded] files: simulation/member_move_options_{black-white,black,blue,diamond,gold,pearl,red,ruby,sapphire,silver,white,x,y}.parquet
    MEMBER_MOVE_OPTIONS_SHARDED {
        string team_member_id CK
        string source_team_id
        string game_version
        int slot
        string pokemon_species
        int level
        string move_name CK
        int option_rank
        float option_score
        string moveset_context_id
    }

    %% [sharded] files: simulation/member_moveset_combos_{black-white,black,blue,diamond,gold,pearl,red,ruby,sapphire,silver,white,x,y}.parquet
    MEMBER_MOVESET_COMBOS_SHARDED {
        string moveset_combo_id PK
        string team_id
        string pokemon_instance_id
        int slot_index
        string game_version
        string pokemon_name
        int level
        string moves_list
        int move_count
        int combo_rank
        float combo_score
        string source
        string move_1
        string move_2
        string move_3
        string move_4
    }

    %% [sharded] files: simulation/pokemon_combat_pool_{black-white,black,blue,diamond,gold,pearl,red,ruby,sapphire,silver,white,x,y}.parquet
    POKEMON_COMBAT_POOL_SHARDED {
        string game_version CK
        string pokemon_species CK
        int level CK
    }

    %% [sharded] files: simulation/pokemon_moveset_options_{black-white,black,blue,diamond,gold,pearl,red,ruby,sapphire,silver,white,x,y}.parquet
    POKEMON_MOVESET_OPTIONS_SHARDED {
        string moveset_context_id CK
        string game_version
        string pokemon_species
        int level
        string move_policy
        float candidate_move_count
        string move_name CK
        float option_rank
        float option_score
    }

    %% [sharded] files: simulation/simulation_sampling_plan_{black-white,black,blue,diamond,gold,pearl,red,ruby,sapphire,silver,white,x,y}.parquet
    SIMULATION_SAMPLING_PLAN_SHARDED {
        string source_team_id CK
        string sampling_seed CK
        string move_policy
        int max_moves_per_member
        int estimated_combo_space
    }

    MOVE_DATA_PARQUET {
        string pokemon_instance_id PK
        string team_id
        string species
        int level
        string game_version
        string provided_moves_list
        string learnable_moves_list
        string move_details_struct
        int slot_index
    }

    GAMES_PARQUET ||--o{ BOSSES_PARQUET : "physical game_version"
    GAMES_PARQUET ||--o{ PROGRESSION_DEPTH_PARQUET : "physical game_version"
    GAMES_PARQUET ||--o{ LEARNABLE_MOVES_PARQUET : "physical game_version"
    GAMES_PARQUET ||--o{ SOURCE_TEAMS_SHARDED : "physical game_version"
    GAMES_PARQUET ||--o{ POKEMON_COMBAT_POOL_SHARDED : "physical game_version"
    GAMES_PARQUET ||--o{ MOVE_DATA_PARQUET : "iFK game_version"

    BOSSES_PARQUET ||--|| PROGRESSION_DEPTH_PARQUET : "physical boss_id + game_version"
    BOSSES_PARQUET ||--o| SOURCE_TEAMS_SHARDED : "iFK boss teams only"

    PROGRESSION_DEPTH_PARQUET ||--o{ ENCOUNTERS_PARQUET : "inferred game/boss_id; 36 known gaps"
    PROGRESSION_DEPTH_PARQUET ||--o{ SOURCE_TEAMS_SHARDED : "iFK player teams only"

    POKEMON_DATA_PARQUET ||--o{ LEARNABLE_MOVES_PARQUET : "inferred species; 98 known gaps"
    POKEMON_DATA_PARQUET ||--o{ SOURCE_TEAM_MEMBERS_SHARDED : "iFK pokemon_species"
    POKEMON_DATA_PARQUET ||--o{ POKEMON_COMBAT_POOL_SHARDED : "iFK pokemon_species"
    POKEMON_DATA_PARQUET ||--o{ MOVE_DATA_PARQUET : "iFK species"

    MOVE_REFERENCE_PARQUET ||--o{ LEARNABLE_MOVES_PARQUET : "physical move_name"
    MOVE_REFERENCE_PARQUET ||--o{ MEMBER_MOVESET_COMBOS_SHARDED : "iFK move_1..move_4"

    SOURCE_TEAMS_SHARDED ||--|{ SOURCE_TEAM_MEMBERS_SHARDED : "physical source_team_id"
    SOURCE_TEAMS_SHARDED ||--o{ MEMBER_MOVE_OPTIONS_SHARDED : "physical source_team_id"
    SOURCE_TEAMS_SHARDED ||--o{ MEMBER_MOVESET_COMBOS_SHARDED : "iFK team_id -> source_team_id"
    SOURCE_TEAMS_SHARDED ||--o| SIMULATION_SAMPLING_PLAN_SHARDED : "iFK player teams only"
    SOURCE_TEAMS_SHARDED ||--o{ MOVE_DATA_PARQUET : "iFK boss subset only"

    SOURCE_TEAM_MEMBERS_SHARDED ||--o{ MEMBER_MOVE_OPTIONS_SHARDED : "physical team_member_id; optional for boss rows"
    SOURCE_TEAM_MEMBERS_SHARDED ||--o{ MEMBER_MOVESET_COMBOS_SHARDED : "iFK pokemon_instance_id; optional for boss rows"
    SOURCE_TEAM_MEMBERS_SHARDED ||--o| MOVE_DATA_PARQUET : "iFK boss subset only"

    POKEMON_COMBAT_POOL_SHARDED ||--o{ POKEMON_MOVESET_OPTIONS_SHARDED : "iFK game/species/level"
    POKEMON_MOVESET_OPTIONS_SHARDED ||--o{ MEMBER_MOVE_OPTIONS_SHARDED : "iFK reusable moveset context"

    %% No FK edge drawn from BOSS_TEAM_MEMBERS_PARQUET to BOSSES_PARQUET:
    %% current persisted boss ids do not match physically.
    %% No FK edge drawn from LOCATIONS_PARQUET to GAMES_PARQUET:
    %% relation exists logically, but 25 'unknown' rows violate it.
